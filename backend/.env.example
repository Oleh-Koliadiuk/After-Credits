# Comma-separated exact browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Defaults to a SQLite file in backend/data for local development.
# For deployment, use a managed PostgreSQL URL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aftercredits

SESSION_TTL_DAYS=30
